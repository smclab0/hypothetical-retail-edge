apiVersion: 1.2
image:
  arch: x86_64
  imageType: iso
  baseImage: SL-Micro.x86_64-6.2-Default-SelfInstall-GM.install.iso
  outputImageName: retail-store.iso
operatingSystem:
  isoConfiguration:
    installDevice: /dev/sda
  time:
    timezone: Europe/London
  kernelArgs:
    - net.ifnames=1
    - console=ttyS0,115200n8
    - nomodeset
    - textmode=1
  systemd:
    disable:
      - rebootmgr
      - transactional-update.timer
      - transactional-update-cleanup.timer
  users:
    - username: root
      encryptedPassword: ${ROOT_PASSWORD_HASH}
      createHomeDir: true
      sshKeys:
        - ssh-rsa  steve@smclappy0.local
  packages:
    packageList:
      - jq
      - openssh-server-config-rootlogin
      - k3s-selinux
    # k3s-selinux is side-loaded from eib/store/rpms (signature checked against
    # rpms/gpg-keys): its rpm.rancher.io repo has unsigned metadata
    sccRegistrationCode: ${SCC_REG_CODE}
